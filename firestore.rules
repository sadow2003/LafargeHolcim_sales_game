// firestore.rules — Controls WHO can read and write WHAT in Firestore.
//
// RULES SUMMARY:
//   users         → Any logged-in user can READ (leaderboard).
//                   Users can WRITE their own document. Admins can WRITE any.
//                   Admins/managers/market-managers can UPDATE any user
//                   (rank recalculation, points reset after event close).
//
//   products      → Any logged-in user can READ.
//                   Admins, managers, and market-managers can create/update/delete.
//
//   sales         → Users can READ only their own. Admins/managers/market-managers read all.
//                   Any logged-in user can CREATE (with their own userId).
//                   Admins/managers/market-managers can UPDATE (approve/reject/award).
//
//   broadcasts    → Any logged-in user can READ and CREATE (own authorId).
//                   Author or admin can DELETE. Anyone can react.
//
//   notifications → Users can READ and mark-as-read only their own.
//                   Any authenticated user can CREATE.
//
//   settings      → Any logged-in user can READ (salesEvent, lastEventResult).
//                   Only market-managers and admins can WRITE (event + reward management).

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isManager() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'sales-manager';
    }

    function isMarketManager() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'market-manager';
    }

    // Covers all privileged roles — shared by any rule managers should access.
    function isAdminOrManager() {
      return isAdmin() || isManager() || isMarketManager();
    }

    // ── users collection ──────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Self-registration may only create a salesperson document.
      // Elevated roles (admin / sales-manager / market-manager) are written
      // exclusively by the createUserProfile Cloud Function (Admin SDK, bypasses
      // rules) after server-side secret validation.
      allow create: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == 'salesperson') ||
        isAdmin()
      );

      // Owners may update their own profile fields (name, photo, FCM token…)
      // but must not touch role, points, or rank — those are privileged fields
      // managed by admins, managers, and Cloud Functions only.
      allow update: if isAuthenticated() && (
        (isOwner(userId) && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['role', 'totalPoints', 'rank'])) ||
        isAdminOrManager()
      );

      allow delete: if isAdmin() && !isOwner(userId);
    }

    // ── products collection ───────────────────────────────────────────────
    match /products/{productId} {
      allow read:  if isAuthenticated();
      allow write: if isAdminOrManager();
    }

    // ── sales collection ──────────────────────────────────────────────────
    match /sales/{saleId} {
      allow read: if isAuthenticated() &&
        (isAdminOrManager() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdminOrManager();
      allow delete: if false;
    }

    // ── broadcasts collection ─────────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      );
      allow delete: if isAuthenticated() &&
        (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ── notifications collection ──────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ── settings collection ───────────────────────────────────────────────
    // Includes: salesEvent (active event + rewards), lastEventResult (winners).
    // All authenticated users read so the reward screen and sale-claim gate work.
    // Only market-managers and admins write (event creation/close).
    match /settings/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin() || isMarketManager();
    }

  }
}
