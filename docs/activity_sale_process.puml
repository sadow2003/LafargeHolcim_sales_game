@startuml Sale_Process_Activity
!theme plain

skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #003366
skinparam ActivityDiamondBackgroundColor #FFF9C4
skinparam ActivityDiamondBorderColor #F9A825
skinparam ActivityStartColor #003366
skinparam ActivityEndColor #003366
skinparam ArrowColor #444444
skinparam PartitionBorderColor #888888
skinparam PartitionBackgroundColor #F5F5F5
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #F9A825

title Sale Submission Process

|#E3F2FD| Salesperson |
|#E8F5E9| Sales Manager |
|#EBF5FB| System (Firebase) |

|Salesperson|
start

:Open Sale Claim Form;

:Select Product from dropdown;

:Enter Quantity sold;

:Attach Proof Image;
note right
  Camera or Gallery
end note

if (Image selected?) then (no)
  :Show error\n"Image required";
  stop
else (yes)
endif

:Preview estimated points\n(productPoints × quantity);

:Submit Claim;

|System (Firebase)|
:Compress proof image\n(max 1280px, 70% quality);

:Upload image to\nFirebase Storage;

:Create Sale document\nstatus = "pending";

:Send push notification\nto Sales Manager;

|Sales Manager|
:Receive notification\n"New Sale Claim";

:Open Sales Approval screen;

:Review sale details\n(product, quantity, proof image);

if (Is sale valid?) then (yes)
  :Approve Sale;

  |System (Firebase)|
  :Check active Sales Event;

  if (Active event exists?) then (yes)
    :Calculate event points\n(productPoints × quantity);
    :Add event points to user;
  else (no)
  endif

  :Add points to totalPoints;

  :Update progress quantity\n(progressQuantity += quantity);

  :Recalculate all ranks;

  :Check milestone badges;

  if (Milestone reached?) then (yes)
    :Post milestone broadcast;
  else (no)
  endif

  :Delete proof image\nfrom Storage;

  :Update Sale status\n= "approved";

  |Salesperson|
  :See updated points\n& rank on Leaderboard;

else (no)
  :Reject Sale;

  |System (Firebase)|
  :Delete proof image\nfrom Storage;

  :Update Sale status\n= "rejected";

  |Salesperson|
  :Sale marked as rejected;
endif

stop

@enduml
