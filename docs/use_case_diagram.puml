@startuml LafargeHolcim_SalesQuest_UseCases
!theme plain
top to bottom direction

skinparam ActorStyle awesome
skinparam ActorBorderColor #003366
skinparam ActorFontSize 11
skinparam UsecaseBorderColor #003366
skinparam UsecaseBackgroundColor #FFFFFF
skinparam UsecaseFontSize 10
skinparam ArrowColor #555555
skinparam ArrowFontSize 9
skinparam rectangleBorderColor #003366
skinparam rectangleBackgroundColor #F9F9F9
skinparam padding 3
skinparam nodesep 10
skinparam ranksep 16

title Diagramme de Cas d'Utilisation -- LafargeHolcim SalesQuest

' ══ ACTEURS ══
actor "Commercial"        as SP   #LightBlue
actor "Resp.\nCommercial" as SM   #LightGreen
actor "Resp.\nMarche"     as MM   #LightYellow
actor "Administrateur"    as AD   #LightSalmon
actor "API Groq\n(IA)"    as GROQ #LightGray

rectangle "SalesQuest" {

  ' UC_AUTH au sommet : point d entree commun
  usecase "S'authentifier" as UC_AUTH

  ' -- blocs principaux --
  together {
    usecase "Soumettre\nune vente" as UC_SALE
    usecase "Joindre\nune preuve"  as UC_IMG
  }
  together {
    usecase "Voir le\nclassement" as UC_LDR
    usecase "Voir le podium"      as UC_POD
  }
  usecase "Consulter les\nrecompenses" as UC_REWD
  together {
    usecase "Coach IA -- Max"     as UC_AI
    usecase "Envoyer un\nmessage" as UC_MSG
  }
  together {
    usecase "Approuver /\nRejeter vente" as UC_APP
    usecase "Notifier\nle commercial"    as UC_NOTIF
  }
  usecase "Gerer les\nproduits"     as UC_PROD
  together {
    usecase "Creer un\nevenement"         as UC_EVT
    usecase "Configurer\nles recompenses" as UC_CONF
  }
  usecase "Fil d'actualite"       as UC_BC
  usecase "Gerer les\nutilisateurs" as UC_USR
}

' ══ INCLUDE S'AUTHENTIFIER (tous sauf Groq) ══
UC_SALE ..> UC_AUTH : <<include>>
UC_LDR  ..> UC_AUTH : <<include>>
UC_REWD ..> UC_AUTH : <<include>>
UC_AI   ..> UC_AUTH : <<include>>
UC_APP  ..> UC_AUTH : <<include>>
UC_PROD ..> UC_AUTH : <<include>>
UC_EVT  ..> UC_AUTH : <<include>>
UC_BC   ..> UC_AUTH : <<include>>
UC_USR  ..> UC_AUTH : <<include>>

' ══ INCLUDE / EXTEND locaux (sub-cas) ══
UC_SALE ..> UC_IMG   : <<include>>
UC_LDR  ..> UC_POD   : <<extend>>
UC_AI   ..> UC_MSG   : <<include>>
UC_EVT  ..> UC_CONF  : <<include>>
UC_APP  ..> UC_NOTIF : <<include>>

' ══ LIENS ACTEURS ══
SP --> UC_SALE
SP --> UC_LDR
SP --> UC_REWD
SP --> UC_AI
SP --> UC_BC

SM --> UC_APP
SM --> UC_PROD
SM --> UC_BC

MM --> UC_EVT
MM --> UC_BC

AD --> UC_USR
AD --> UC_BC

GROQ --> UC_AI

@enduml
