@startuml LafargeHolcim_SalesQuest_UseCases
!theme plain
skinparam ActorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #555555
skinparam ActorBorderColor #003366
skinparam ActorBackgroundColor #E8F0FE
skinparam UsecaseBorderColor #003366
skinparam UsecaseBackgroundColor #FFFFFF
skinparam PackageBorderColor #AAAAAA
skinparam PackageBackgroundColor #F9F9F9
left to right direction

title Diagramme de Cas d'Utilisation — LafargeHolcim SalesQuest

' ═══ ACTEUR GAUCHE (seul) ═══

actor "Commercial" as SP #LightBlue

' ══════════════════════════════════════
package "Authentification" {
  usecase "Créer un compte"  as UC_REG
  usecase "Se connecter"     as UC_LOG
  usecase "Se déconnecter"   as UC_OUT
}

package "Espace Commercial" {
  usecase "Voir le tableau de bord"    as UC_DASH
  usecase "Parcourir les produits"     as UC_PROD
  usecase "Soumettre une vente"        as UC_SALE
  usecase "Voir le classement"         as UC_LDR
  usecase "Suivre les jalons"          as UC_MILE
  usecase "Consulter les récompenses"  as UC_REWD
  usecase "Modifier le profil"         as UC_PROF
}

package "Espace Responsable\nCommercial" {
  usecase "Tableau de bord responsable"  as UC_MDASH
  usecase "Approuver / Rejeter une vente" as UC_APP
  usecase "Gérer les produits"           as UC_PROD2
  usecase "Recevoir des notifications"   as UC_NOTIF
}

package "Espace Responsable\nMarché" {
  usecase "Tableau de bord marché"      as UC_MMDASH
  usecase "Créer un événement"          as UC_CREV
  usecase "Configurer les récompenses"  as UC_CREWD
  usecase "Voir les résultats"          as UC_ERESLT
}

UC_CREV ..> UC_CREWD : <<include>>

package "Espace Administrateur" {
  usecase "Tableau de bord admin"   as UC_ADASH
  usecase "Gérer les utilisateurs"  as UC_UMGMT
}

package "Fonctionnalités\npartagées" {
  usecase "Fil d'actualité"    as UC_BFEED
  usecase "Publier une annonce" as UC_BPOST
}

package "Coach IA — Max" {
  usecase "Ouvrir le coach IA"       as UC_AI_OPEN
  usecase "Envoyer un message"       as UC_AI_SEND
  usecase "Recevoir la réponse IA"   as UC_AI_REPLY
}

UC_AI_OPEN ..> UC_AI_SEND  : <<include>>
UC_AI_SEND ..> UC_AI_REPLY : <<include>>

' ═══ ACTEURS DROITE ═══
actor "Responsable\nCommercial"  as SM   #LightGreen
actor "Responsable\nMarché"     as MM   #LightYellow
actor "Administrateur"          as AD   #LightSalmon
actor "API Groq (IA)"           as GROQ #LightGray

' ─── LIENS ───

SP --> UC_REG
SP --> UC_LOG
SP --> UC_OUT

SM --> UC_REG
SM --> UC_LOG
SM --> UC_OUT

MM --> UC_REG
MM --> UC_LOG
MM --> UC_OUT

UC_REG -- AD
UC_LOG -- AD
UC_OUT -- AD 

SP --> UC_DASH
SP --> UC_PROD
SP --> UC_SALE
SP --> UC_LDR
SP --> UC_MILE
SP --> UC_REWD
SP --> UC_PROF
SP --> UC_AI_OPEN

SM --> UC_MDASH
SM --> UC_APP
SM --> UC_PROD2
SM --> UC_NOTIF

MM --> UC_MMDASH
MM --> UC_CREV
MM --> UC_ERESLT

UC_ADASH -- AD
UC_UMGMT -- AD

SP --> UC_BFEED
SP --> UC_BPOST
SM --> UC_BFEED
SM --> UC_BPOST
MM --> UC_BFEED
MM --> UC_BPOST
UC_BFEED -- AD
UC_BPOST-- AD 

UC_AI_REPLY -- GROQ

@enduml
