@startuml Diagramme_Classes_SalesQuest
!theme plain
top to bottom direction

skinparam classFontSize 10
skinparam classAttributeFontSize 9
skinparam ArrowFontSize 9
skinparam ArrowColor #444444s
skinparam classBorderColor #003366
skinparam classBackgroundColor #FFFFFF
skinparam packageBorderColor #888888
skinparam packageBackgroundColor #FAFAFA
skinparam padding 3
skinparam nodesep 18
skinparam ranksep 28

title Diagramme de Classes — LafargeHolcim SalesQuest

' ═══════════════════════════════════════════
'  UTILISATEURS
' ═══════════════════════════════════════════

class User {
  + uid : String
  + nom : String
  + email : String
  + role : String
  + fcmToken : String?
  + photo_Url : String?
}

class Commercial {
  + PointsTotal : int
  + rank : int
  + progress_Quality : int
  --
  + soumettre_Vente()
  + classement_vue()
  + Messager_AI()
  + collecterRecompenses()
}

class ResponsableVente {
  + Vente_Attends : List~Vente~
  --
  + approuverVente()
  + rejeterVente()
  + CréerProduit()
  + ModifierProduit()
  + supprimerProduit()
}

class ResponsableMarché {
  + Evenement_actif : EvenementVente
  --
  + créerEvenement()
  + afficherResultats()
  + annulerEvenement()
}

class Administrateur {
  + Users : List~User~
  --
  + créerUtilisateur()
  + modifierUtilisateur()
  + supprimerUtilisateur()
}

' ═══════════════════════════════════════════
'  IA COACH
' ═══════════════════════════════════════════

class AI_Coach {
  + nomCommercial : String
  + messages : List~String~
  + apiUrl : String
  + systemPrompt : String
  --
  + envoyerMessage()
  + prompt()
}

class ChatMessage {
  + text : String
  + isUser : bool
  + isError : bool
}

' ═══════════════════════════════════════════
'  VENTE & PRODUIT
' ═══════════════════════════════════════════

class Vente {
  + Id : String
  + userId : String
  + productId : String
  + quantity : int
  + status : String
  + Points_gagnants : int
  + Photo_preuve_Url : String
  + CreatedAt : TimeStamp
}

class Produit {
  + id : String
  + name : String
  + category : String
  + Description : String
  + pointsPerUnit : int
}

class Notification {
  + id : String
  + userId : String
  + saleId : String
  + Timestamp : DateTime
  + Message : String
  + titre : String
}

' ═══════════════════════════════════════════
'  ÉVÉNEMENT & RÉCOMPENSES
' ═══════════════════════════════════════════

class EvenementVente {
  + date_debut : DateTime
  + date_fin : DateTime
  + ProductCategory : String
  + productName : String?
  + TargetQuantity : int
  + RecompenseArgent : List~Rewards~
}

class Rewards {
  + id : String
  + Quantity : Double
  + rank : int
  + Commercial_id : String?
  --
  + RecuitPDF()
}

' ═══════════════════════════════════════════
'  BROADCAST & JALONS
' ═══════════════════════════════════════════

class Broadcast {
  + id : String
  + authorId : String
  + content : String
  + reactions : String
  + date : Timestamp
  + isJaslon : Boolean
}

class Jaslon {
  + id : String
  + Nom_Commercial : String
  + PointTotal : String
  + Message : String
}

' ═══════════════════════════════════════════
'  HÉRITAGE — tous les rôles héritent de User
' ═══════════════════════════════════════════
Commercial       --|> User
ResponsableVente --|> User
ResponsableMarché --|> User
Administrateur   --|> User

' ═══════════════════════════════════════════
'  ASSOCIATIONS
' ═══════════════════════════════════════════

' Commercial
Commercial "1" --> "n" Vente         : soumet
Commercial "1" --> "n" Rewards       : collecte
Commercial      --> AI_Coach         : consulte

' Vente
Vente "n" --> "1" Produit            : concerne
Vente "1" ..> "1" Notification       : déclenche

' ResponsableVente
ResponsableVente "1" --> "n" Vente   : gère / approuve

' ResponsableMarché
ResponsableMarché "1" --> "0..1" EvenementVente : gère

' Administrateur
Administrateur "1" --> "n" User      : administre

' IA Coach
AI_Coach "1" *-- "n" ChatMessage     : historique

' Événement
EvenementVente "1" *-- "n" Rewards   : récompenses

' Broadcast / Jalon
Jaslon --|> Broadcast                : est un type de
Broadcast "n" --> "1" User          : publiée par

@enduml
