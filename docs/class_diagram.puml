@startuml Diagramme_Classes_SalesQuest
!theme plain
top to bottom direction

skinparam classFontSize 10
skinparam classAttributeFontSize 9
skinparam ArrowFontSize 9
skinparam ArrowColor #444444
skinparam classBorderColor #003366
skinparam classBackgroundColor #FFFFFF
skinparam packageBorderColor #888888
skinparam packageBackgroundColor #FAFAFA
skinparam padding 3
skinparam nodesep 18
skinparam ranksep 28
skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #999999

title Diagramme de Classes — LafargeHolcim SalesQuest\n(reflète les documents Firestore et services réels, pas des classes du code)

' ═══════════════════════════════════════════
'  UTILISATEURS  — document Firestore "users"
' ═══════════════════════════════════════════

class User {
  + uid : String
  + firstName : String
  + lastName : String
  + email : String
  + role : String
  + totalPoints : int
  + rank : int
  + progressQuantity : int
  + fcmToken : String?
  + photoUrl : String?
  + createdAt : Timestamp
}
note right of User
  Un seul document Firestore par utilisateur ;
  "Commercial / ResponsableVente / ResponsableMarché /
  Administrateur" ne sont pas des sous-classes réelles,
  seulement des valeurs du champ **role**.
end note

class Commercial <<role: salesperson>> {
  --
  + submitSale()
  + viewRanking()
  + openAiCoach()
  + viewRewardStore()
}

class ResponsableVente <<role: sales-manager>> <<service>> {
  --
  + approveSale()
  + rejectSale()
  + createProduct()
  + updateProduct()
  + deleteProduct()
  + recalculateRanks()
  + checkMilestone()
  + cleanupOldProofImages()
}
note right of ResponsableVente
  Implémenté par ManagerService (méthodes statiques)
  operant sur les collections "sales" / "products".
end note

class ResponsableMarché <<role: market-manager>> <<service>> {
  --
  + createEvent()
  + deleteEvent()
  + displayResults()
}
note right of ResponsableMarché
  Implémenté par EventManagementService (méthodes statiques).
  L'événement actif n'est pas stocké sur l'objet : il est lu
  en direct via eventStream() sur settings/salesEvent.
end note

class Administrateur <<role: admin>> <<service>> {
  --
  + createUser()
  + updateUser()
  + deleteUser()
  + recalculateRanks()
}
note right of Administrateur
  Implémenté par UserService (méthodes statiques),
  pas de champ "users : List<User>" en mémoire.
end note

' ═══════════════════════════════════════════
'  IA COACH
' ═══════════════════════════════════════════

class AiCoachService <<service>> {
  --
  + sendMessage(history: List~Map~) : String
}
note right of AiCoachService
  Appelle la Cloud Function "getAiCoachReply".
  Le systemPrompt (personnalité "Max") vit uniquement
  côté serveur (functions/main.py), jamais dans le client.
end note

class ChatMessage {
  + text : String
  + isUser : bool
  + isError : bool
}

' ═══════════════════════════════════════════
'  VENTE & PRODUIT — collections "sales" / "products"
' ═══════════════════════════════════════════

class Vente {
  + id : String
  + userId : String
  + userName : String
  + productId : String
  + productName : String
  + productCategory : String
  + quantity : int
  + status : String
  + pointsAwarded : int
  + proofImageUrl : String
  + createdAt : Timestamp
}

class Produit {
  + id : String
  + name : String
  + category : String
  + description : String
  + productPoints : int
}

class Notification {
  + id : String
  + userId : String
  + saleId : String
  + title : String
  + body : String
  + read : bool
  + timestamp : Timestamp
  --
  + markAsRead()
}
note right of Notification
  Distinct des pushs FCM envoyés directement par les
  Cloud Functions (title/body uniquement, non persistés).
end note

' ═══════════════════════════════════════════
'  ÉVÉNEMENT & RÉCOMPENSES — doc "settings/salesEvent"
' ═══════════════════════════════════════════

class EvenementVente {
  + startDate : DateTime
  + endDate : DateTime
  + productCategory : String
  + productId : String?
  + productName : String?
  + targetQuantity : int
  + rewards : Map~String, MoneyReward~
  + createdBy : String
  + updatedAt : Timestamp
}
note right of EvenementVente
  "rewards" est une Map indexée par rang ("1"/"2"/"3"),
  pas une List.
end note

class MoneyReward {
  + amount : double
}

class EventResult {
  + rank : int
  + userId : String
  + userName : String
  + rewardAmount : double
  + closedAt : Timestamp
}
note right of EventResult
  Snapshot du classement final, stocké dans
  settings/lastEventResult à la clôture de l'événement.
end note

class RewardReceiptPdf <<service>> {
  --
  + share(userName, rank, rewardAmount, closedAt, userId)
}

' ═══════════════════════════════════════════
'  BROADCAST & JALONS — collection "broadcasts"
' ═══════════════════════════════════════════

class Broadcast {
  + id : String
  + authorId : String
  + authorName : String
  + authorRole : String
  + authorPhotoUrl : String?
  + content : String
  + reactions : Map~String, List~String~~
  + createdAt : Timestamp
  + type : String
  + isMilestone : bool?
  + pointsAtTime : int?
  + rankAtTime : int?
  + eventPhase : String?
  + eventCategory : String?
  + eventProductName : String?
  + awardedUserId : String?
  + awardedUserName : String?
  + milestoneCount : int?
}
note right of Broadcast
  "type" ∈ {general, event, milestone}. Un "Jalon" (milestone)
  n'est PAS une sous-classe : c'est le même document Broadcast
  avec type="milestone" / isMilestone=true.
  "reactions" est une Map emoji → liste d'userId, pas un String.
end note

' ═══════════════════════════════════════════
'  HÉRITAGE — rôles au sein de "users" (conceptuel)
' ═══════════════════════════════════════════
Commercial       ..|> User : role
ResponsableVente ..|> User : role
ResponsableMarché ..|> User : role
Administrateur   ..|> User : role

' ═══════════════════════════════════════════
'  ASSOCIATIONS
' ═══════════════════════════════════════════

' Commercial
Commercial "1" --> "n" Vente         : soumet
Commercial      --> AiCoachService   : consulte
Commercial "1" --> "n" EventResult   : peut recevoir

' Vente
Vente "n" --> "1" Produit            : concerne
Vente "1" ..> "1" Notification       : déclenche (trigger Firestore)

' ResponsableVente
ResponsableVente "1" --> "n" Vente   : gère / approuve
ResponsableVente "1" --> "n" Produit : gère

' ResponsableMarché
ResponsableMarché "1" --> "0..1" EvenementVente : gère

' Administrateur
Administrateur "1" --> "n" User      : administre

' IA Coach
AiCoachService "1" *-- "n" ChatMessage : historique (local, non persisté)

' Événement
EvenementVente "1" *-- "n" MoneyReward : rewards (par rang)
EvenementVente "1" ..> "1" EventResult : clôture vers
EventResult ..> RewardReceiptPdf       : génère

' Broadcast / Jalon
Broadcast "n" --> "1" User          : publié par

@enduml