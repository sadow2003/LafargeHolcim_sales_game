@startuml DiagrammeClasses_SalesQuest
!theme plain
left to right direction

skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #003366
skinparam classHeaderBackgroundColor #D6E4F0
skinparam ArrowColor #444444
skinparam packageStyle rectangle
skinparam PackageBorderColor #888888
skinparam PackageBackgroundColor #F7F7F7
skinparam classFontSize 11
skinparam classAttributeFontSize 10
skinparam padding 4
skinparam nodesep 30
skinparam ranksep 40

title Diagramme de Classes — LafargeHolcim SalesQuest

' ══════════════════════════════════════
'  ÉNUMÉRATION
' ══════════════════════════════════════
enum RoleUtilisateur {
  commercial
  responsable_commercial
  responsable_marche
  admin
}

' ══════════════════════════════════════
'  MODÈLES FIRESTORE
' ══════════════════════════════════════
package "Modèles Firestore" #EBF5FB {

  class Utilisateur {
    + uid : String
    + nom : String
    + email : String
    + role : RoleUtilisateur
    + points : int
    + rang : int
    + fcmToken : String
  }

  class Vente {
    + id : String
    + userId : String
    + produitId : String
    + quantite : int
    + statut : String
    + pointsAttribues : int
  }

  class Produit {
    + id : String
    + nom : String
    + categorie : String
    + pointsParUnite : int
  }

  class Publication {
    + id : String
    + auteurId : String
    + contenu : String
    + reactions : Map~String, List~
    + date : Timestamp
  }

  class EvenementVente {
    + dateDebut : Timestamp
    + objectifQuantite : int
    + recompenses : List~Recompense~
    + dateMAJ : Timestamp
  }

  class Recompense {
    + montant : double
  }

  class Notification {
    + id : String
    + userId : String
    + titre : String
    + lu : bool
  }

  Utilisateur   "1" --> "many" Vente       : soumet
  Utilisateur   "1" --> "many" Publication : publie
  Utilisateur   "1" --> "many" Notification : reçoit
  Vente         "many" --> "1" Produit     : concerne
  EvenementVente "1" *-- "many" Recompense : contient
  Utilisateur ..> RoleUtilisateur : a un rôle
}

' ══════════════════════════════════════
'  ÉCRANS PAR RÔLE
' ══════════════════════════════════════
package "Écrans" #F0F4F8 {

  class EcranCommercial {
    - points : int
    - rang : int
    --
    + soumettreVente() : void
    + voirClassement() : void
    + voirRecompenses() : void
  }

  class EcranResponsableCommercial {
    - ventesPendantes : List~Vente~
    --
    + approuverVente(id) : void
    + rejeterVente(id) : void
  }

  class EcranResponsableMarche {
    - evenementActif : EvenementVente
    --
    + creerEvenement() : void
    + voirResultats() : void
  }

  class EcranAdministrateur {
    - utilisateurs : List~Utilisateur~
    --
    + creerUtilisateur() : void
    + supprimerUtilisateur(id) : void
  }

  class FilActualite {
    - publications : List~Publication~
    --
    + chargerFil() : void
    + publier() : void
  }
}

' ══════════════════════════════════════
'  COACH IA — MAX
' ══════════════════════════════════════
package "Coach IA — Max" #FFF8E7 {

  class EcranCoachIA {
    - nomUtilisateur : String
    - messages : List~MessageChat~
    - chargement : bool
    --
    + envoyerMessage() : void
    + promptRapide(texte) : void
  }

  class ServiceCoachIA <<static>> {
    - {static} urlAPI : String
    - {static} promptSysteme : String
    --
    + {static} envoyerMessage(historique) : Future~String~
  }

  class MessageChat {
    + texte : String
    + estUtilisateur : bool
    + estErreur : bool
  }

  EcranCoachIA "1" *-- "many" MessageChat : contient
  EcranCoachIA ..> ServiceCoachIA         : appelle
}

' ══════════════════════════════════════
'  DÉPENDANCES ÉCRANS → MODÈLES
' ══════════════════════════════════════
EcranCommercial            ..> Vente          : crée
EcranCommercial            ..> Produit        : consulte
EcranResponsableCommercial ..> Vente          : approuve / rejette
EcranResponsableCommercial ..> Notification   : déclenche
EcranResponsableMarche     ..> EvenementVente : configure
EcranAdministrateur        ..> Utilisateur    : gère
FilActualite               ..> Publication    : affiche
EcranCoachIA               ..> Utilisateur    : charge le nom

@enduml
