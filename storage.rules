// storage.rules — Controls who can upload and download files in Firebase Storage.
//
// Our app only stores one type of file:
//   sales_proofs/{filename}  — Proof photos uploaded by salespeople when submitting a sale.
//
// Rules:
//   UPLOAD (write): Any logged-in user can upload to sales_proofs/.
//   DOWNLOAD (read): Any logged-in user can read (needed to display the photo in the admin/manager panel).
//   File size limit: Maximum 5 MB per file (as specified in the requirements).
//   File type limit: Only image files (image/jpeg, image/png, image/webp) are allowed.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── sales_proofs folder ───────────────────────────────────────────────
    // All proof photos are stored here as: sales_proofs/{userId}_{timestamp}.jpg
    match /sales_proofs/{fileName} {

      // UPLOAD: The user must be logged in, file must be an image under 5 MB.
      allow create: if request.auth != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 5 * 1024 * 1024;

      // DELETE: Any logged-in user can delete (request.resource is null on delete,
      // so content-type and size checks cannot be used here).
      allow delete: if request.auth != null;

      // DOWNLOAD: Any logged-in user can view the image.
      allow read: if request.auth != null;
    }

    // ── profile_photos folder ─────────────────────────────────────────────
    // Each user's avatar is stored as: profile_photos/{uid}.jpg
    match /profile_photos/{userId} {
      // Only the owner can upload their own photo.
      allow write: if request.auth != null
        && request.auth.uid == userId.replace('.jpg', '')
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 5 * 1024 * 1024;

      // Any logged-in user can read profile photos (shown in leaderboard/manager views).
      allow read: if request.auth != null;
    }

    // Block access to everything else in Storage by default.
  }
}
